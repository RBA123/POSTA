# Environment Variables for Porta App

# RevenueCat API Keys
# Get these from: https://app.revenuecat.com/settings/api-keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_api_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# Note: These are public API keys (safe to expose in client apps)
# They are prefixed with EXPO_PUBLIC_ to be accessible in the app
