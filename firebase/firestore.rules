rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate user data structure
    // ⚠️ IMPORTANT: All monetary values stored as INTEGER CENTS
    function isValidUserData() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'firstName', 'lastName', 'username', 'dateOfBirth', 
                                  'countryCode', 'friendCode', 'virtualBalance', 'totalPositions',
                                  'activePositions', 'winRate', 'totalWinnings', 'totalLosses',
                                  'notificationsEnabled', 'notificationPreferences', 'createdAt',
                                  'updatedAt', 'isAdmin'])
        && data.email is string
        && data.firstName is string
        && data.lastName is string
        && data.username is string
        && data.virtualBalance is number
        && data.isAdmin is bool;
    }
    
    // ========================================================================
    // USERS COLLECTION
    // ========================================================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile (during signup)
      // Initial balance: 10000 cents = $100.00
      allow create: if isOwner(userId) 
        && isValidUserData()
        && request.resource.data.uid == userId
        && request.resource.data.virtualBalance == 10000; // Initial balance in cents
      
      // Users can update their own profile (with restrictions)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['uid', 'isAdmin', 'virtualBalance', 'totalPositions', 
                    'activePositions', 'winRate', 'totalWinnings', 'totalLosses', 
                    'createdAt', 'referredBy']);
      
      // Admins can read any user
      allow read: if isAdmin();
      
      // Admins can update any user
      allow update: if isAdmin();
      
      // ======================================================================
      // USER SUBCOLLECTIONS
      // ======================================================================
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        // Users can read their own notifications
        allow read: if isOwner(userId);
        
        // Users can update their own notifications (mark as read)
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read', 'readAt']);
        
        // Only Cloud Functions can create notifications
        allow create: if false;
        
        // Only Cloud Functions can delete notifications
        allow delete: if false;
      }
      
      // Payment methods subcollection
      match /paymentMethods/{paymentMethodId} {
        // Users can read their own payment methods
        allow read: if isOwner(userId);
        
        // Users can create their own payment methods
        allow create: if isOwner(userId);
        
        // Users can update their own payment methods
        allow update: if isOwner(userId);
        
        // Users can delete their own payment methods
        allow delete: if isOwner(userId);
      }
      
      // Settings subcollection
      match /settings/{settingsId} {
        // Users can read their own settings
        allow read: if isOwner(userId);
        
        // Users can create/update their own settings
        allow write: if isOwner(userId);
      }
    }
    
    // ========================================================================
    // MARKETS COLLECTION
    // ========================================================================
    match /markets/{marketId} {
      // Anyone can read markets (public)
      allow read: if true;
      
      // Only admins can create markets
      allow create: if isAdmin();
      
      // Only admins can update markets
      allow update: if isAdmin();
      
      // Only admins can delete markets
      allow delete: if isAdmin();
      
      // ======================================================================
      // MARKET SUBCOLLECTIONS
      // ======================================================================
      
      // Bets subcollection (for market-level aggregation)
      match /bets/{betId} {
        // Anyone can read bets (for leaderboards)
        allow read: if true;
        
        // Only Cloud Functions can create bets
        allow create: if false;
        
        // Only Cloud Functions can update/delete bets
        allow write: if false;
      }
    }
    
    // ========================================================================
    // USER BETS COLLECTION
    // ========================================================================
    match /userBets/{betId} {
      // Users can read their own bets
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Only Cloud Functions can create bets
      allow create: if false;
      
      // Only Cloud Functions can update bets (settlement)
      allow update: if false;
      
      // Only Cloud Functions can delete bets
      allow delete: if false;
    }
    
    // ========================================================================
    // TRANSACTIONS COLLECTION
    // ========================================================================
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      
      // Only Cloud Functions can create transactions
      allow create: if false;
      
      // Only Cloud Functions can update transactions
      allow update: if false;
      
      // Only Cloud Functions can delete transactions
      allow delete: if false;
    }
    
    // ========================================================================
    // DEFAULT DENY
    // ========================================================================
    // Any other collection is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

